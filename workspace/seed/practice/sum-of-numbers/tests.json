{
  "title": "Sum of numbers",
  "topic": "fundamentals",
  "difficulty": "easy",
  "language": "cpp",
  "starter": "main.cpp",
  "tests": [
    {
      "name": "example",
      "input": "4\n1 2 3 4\n",
      "expected": "10"
    },
    {
      "name": "single",
      "input": "1\n-5\n",
      "expected": "-5"
    },
    {
      "name": "empty",
      "input": "0\n",
      "expected": "0"
    },
    {
      "name": "big values (overflow?)",
      "input": "3\n2000000000 2000000000 2000000000\n",
      "expected": "6000000000"
    }
  ]
}
