{
  "name": "arzin-lab-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Write code, run it for real, watch it execute, and ask about anything.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"tsx watch --clear-screen=false server/src/index.ts\" \"vite\"",
    "build": "tsc -p web/tsconfig.json && tsc -p server/tsconfig.json && vite build",
    "start": "tsx server/src/index.ts",
    "typecheck": "tsc -p web/tsconfig.json && tsc -p server/tsconfig.json"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dockerode": "^5.0.1",
    "dompurify": "^3.4.16",
    "express": "^5.2.1",
    "marked": "^18.1.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
